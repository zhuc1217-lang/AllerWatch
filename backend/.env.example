# Examples only: set actual environment variables in PowerShell or Render.
# The backend does not automatically load this file.
PUBLIC_DEMO_MODE=false
FRONTEND_ORIGIN=http://localhost:5173
# Unset DATABASE_PATH keeps the existing local data/private/allerwatch.sqlite3.
