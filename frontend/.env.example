# Optional local override; without it Vite /api proxies to localhost:8000.
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Render Static Site: replace with the backend HTTPS origin, without /api.
# VITE_API_BASE_URL=https://YOUR-BACKEND.onrender.com
# VITE_ variables are public, build-time values. Never put secrets here.
